{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halmic-sports",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Private playtest host. The game files are not in this repo: they live in the R2 bucket below, uploaded from the owner's
  // Mac (see README.md). Secret, set once with `wrangler secret put SPORTS_PASSKEY`; without it the Worker refuses everything.
  // Requires the halmic.com zone in the Cloudflare account. workers.dev and preview URLs are off: sports.halmic.com is the only address.
  "routes": [{ "pattern": "sports.halmic.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // The passkey gate: "off" opens the site to anyone with the address (no secret needed); "on" puts it back.
  "vars": { "SPORTS_GATE": "off" },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "halmic-sports" }],
  // The online count and the leaderboards (worker/stats.js): one Durable Object with SQLite storage, created by the deploy.
  // The online lobbies and netplay rooms (worker/online.js): one Durable Object, in memory only.
  // The accounts (worker/club.js): one Durable Object with SQLite storage, created by the deploy.
  "durable_objects": { "bindings": [{ "name": "STATS", "class_name": "Stats" }, { "name": "ONLINE", "class_name": "Online" }, { "name": "CLUB", "class_name": "Club" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Stats"] }, { "tag": "v2", "new_sqlite_classes": ["Online"] }, { "tag": "v3", "new_sqlite_classes": ["Club"] }],
  "observability": { "enabled": true }
}
