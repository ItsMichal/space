{
  "name": "@space/halmic",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node build.mjs && node serve.mjs",
    "build": "node scripts/content/validate.mjs && node build.mjs",
    "content:pull": "node scripts/content/pull.mjs",
    "content:check": "node scripts/content/validate.mjs",
    "deploy": "node scripts/content/validate.mjs && node build.mjs && wrangler deploy",
    "sync:youtube": "node ./scripts/sync-youtube.mjs",
    "test": "node --test md.test.mjs worker/live.test.mjs worker/clips.test.mjs && node scripts/check-links.mjs && node scripts/check-social.mjs --dir public --quiet",
    "og": "node scripts/build-og.mjs",
    "check:social": "node scripts/check-social.mjs"
  },
  "dependencies": {
    "@space/crosslinks": "*",
    "@space/glyph-art": "*"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
