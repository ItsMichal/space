{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  // The hosted writing tool (docs/write.md). Separate from the `space` Worker: the public site never contains editor code.
  "name": "write",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The editor SPA (npm run write:build). The Worker runs first for every request so the Access check covers the static files too;
  // unknown paths fall back to index.html (client-side routes).
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Reachable only through the Access-protected custom domain: no workers.dev address, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "write.michal.ai", "custom_domain": true }],
  // ACCESS_TEAM_DOMAIN and ACCESS_AUD come from the Cloudflare Access application (docs/write.md). While either is empty every
  // request is refused. GitHub credentials are secrets, never vars.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "GITHUB_OWNER": "ItsMichal",
    "GITHUB_REPO": "space",
    "GITHUB_BASE": "main",
    "SITE_ORIGIN": "https://michal.ai"
  },
  "observability": { "enabled": true }
}
