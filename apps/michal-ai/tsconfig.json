{
  "extends": "@space/config/tsconfig.react.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    },
    "rootDirs": [".", "./.react-router/types"],
    "types": ["vite/client"]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", ".react-router/types/**/*"],
  // write/worker and write/dist belong to the editor that ItsMichal/space-content lays over this app (it typechecks them itself).
  "exclude": ["node_modules", "worker", "write/worker", "write/dist", "build", ".react-router", "scripts/parity"]
}
