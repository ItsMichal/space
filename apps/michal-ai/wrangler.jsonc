{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "space",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Prerendered site (react-router build). The Worker runs first for every request (host and legacy redirects, live API, 404 status)
  // and reads files through the ASSETS binding; slash handling and 404 pages are decided in worker/static.ts and worker/index.ts.
  "assets": {
    "directory": "build/client",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "PRESENCE", "class_name": "PresenceRoom" },
      { "name": "REACTIONS", "class_name": "ReactionsRoom" }
    ]
  },
  // Live features (docs/presence.md). Reactions and views are on; presence pins stay off (PRESENCE_PINS in lib/presence/flag.ts).
  // LIVE_KILL "1" is the emergency switch: every /api/live/* route answers 204 and the row disappears. VIEWS_PUBLIC "0" hides the
  // number but keeps counting. LIVE_BLOCK_REACTIONS stays unset (paragraph reactions off).
  "vars": {
    "LIVE_KILL": "0",
    "VIEWS_PUBLIC": "1"
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PresenceRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ReactionsRoom"] }
  ],
  "triggers": { "crons": ["17 */6 * * *"] },
  "observability": { "enabled": true }
}
