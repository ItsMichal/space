/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Image variants are named by width, not content hash, so keep these shorter than a year.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/botanical/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/textures/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/motion/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
