/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Font files keep the content-hashed names the previous build gave them.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Image variants are named by width, not content hash, so keep these shorter than a year.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/botanical/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/textures/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/motion/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Client navigations fetch <route>.data (loader results). Revalidating every one costs a round trip before a route change can start;
# a minute of freshness (and a stale copy while it refreshes) lets intent-prefetched and repeat navigations start at once. The data
# only changes at a deploy, and a stale copy of last deploy's data renders fine.
/*.data
  Cache-Control: public, max-age=60, stale-while-revalidate=600
