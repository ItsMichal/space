# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local


# typescript
*.tsbuildinfo
next-env.d.ts

.env
# cloudflare
.open-next
.wrangler
.dev.vars
cloudflare-env.d.ts

# writing tool trash (deleted posts are moved here, never hard-deleted)
apps/michal-ai/content/.trash/
.claude/

# generated by scripts/build-images.mjs
apps/michal-ai/public/media/_v/
apps/michal-ai/public/media/_og/
apps/michal-ai/lib/media/manifest.json

# font files under evaluation (licence unclear): never commit
apps/michal-ai/assets-src/fonts-eval/
apps/michal-ai/public/fonts-eval/

# large source photos (re-fetch with scripts/fetch-botanical-photos.py)
apps/michal-ai/assets-src/botanical-photo/*.jpg
apps/michal-ai/assets-src/botanical-photo/search*/
apps/michal-ai/assets-src/botanical-photo/*.json
!apps/michal-ai/assets-src/botanical-photo/_meta.json
apps/*/scripts/_*.mjs

# build-images state (share-card stamps); cached in CI
apps/michal-ai/.cache/

# parity harness output (golden and candidate snapshots, screenshots)
apps/michal-ai/.parity/

# content checkout used by npm run content:pull (ItsMichal/space-content)
apps/michal-ai/.content/
# local scratch
/tmp/

# react router
apps/michal-ai/build/
apps/michal-ai/.react-router/

# motion audit harness output (apps/michal-ai/scripts/motion): committed runs live under docs/motion/<pr>/
apps/michal-ai/docs/motion/run/
apps/michal-ai/docs/motion/_*/
apps/michal-ai/.wrangler-motion.jsonc

# written into a space checkout by the content repo editor overlay (its scripts/halmic-generated.mjs)
apps/michal-ai/lib/editor/halmic-facts.generated.ts
apps/michal-ai/write/worker/halmic-deny.generated.ts
