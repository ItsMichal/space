# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local


# typescript
*.tsbuildinfo
next-env.d.ts

.env
# cloudflare
.open-next
.wrangler
.dev.vars
cloudflare-env.d.ts

# writing tool trash (deleted posts are moved here, never hard-deleted)
apps/michal-ai/content/.trash/
.claude/

# generated by scripts/build-images.mjs
apps/michal-ai/public/media/_v/
apps/michal-ai/lib/media/manifest.json

# font files under evaluation (licence unclear): never commit
apps/michal-ai/assets-src/fonts-eval/
apps/michal-ai/public/fonts-eval/

# large source photos (re-fetch with scripts/fetch-botanical-photos.py)
apps/michal-ai/assets-src/botanical-photo/*.jpg
apps/michal-ai/assets-src/botanical-photo/search*/
apps/michal-ai/assets-src/botanical-photo/*.json
!apps/michal-ai/assets-src/botanical-photo/_meta.json
apps/*/scripts/_*.mjs
